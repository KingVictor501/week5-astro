---
import { titleCase } from '../lib/titleCase';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import JsonLd from '../components/JsonLd.astro';
import SEO, { type Props as SEOProps } from '../components/SEO.astro';
import { DEFAULT_OG_IMAGE, OWNER_NAME, SERVICE_AREA, SERVICES, SITE_DESCRIPTION, SITE_TITLE, SOCIAL_LINKS } from '../consts';
import { pagePath } from '../lib/path';
import {
  breadcrumbSchema,
  organizationId,
  personId,
  webPageSchema,
  webSiteSchema,
  type Crumb,
  type FaqItem,
  type PageType,
} from '../lib/schema';

export type Props = SEOProps & {
  /** Landing pages: no site header or footer; the page fills the "top" and "bottom" slots instead. */
  minimal?: boolean;
  /** schema.org type for this page's WebPage entity (default WebPage). */
  pageType?: PageType;
  /** Breadcrumb trail, emitted as BreadcrumbList JSON-LD. Pages also render <Breadcrumbs> with it. */
  crumbs?: Crumb[];
  /** The page's visible FAQs. Adds FAQPage markup, so pass exactly what the page shows. */
  faq?: FaqItem[];
  /** @id of the page's main entity (Service, Person, BlogPosting), emitted by the page itself. */
  mainEntityId?: string;
};

const { minimal = false, pageType, crumbs, faq, mainEntityId, ...props } = Astro.props;
const site = Astro.site!;
const siteURL = new URL('/', Astro.site).href;

// Site-wide business entity. Only facts we actually know; no invented address,
// phone, or ratings. The founder is the site owner (Person entity on /about).
const organization = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'ProfessionalService'],
  '@id': organizationId(site),
  name: SITE_TITLE,
  url: siteURL,
  description: SITE_DESCRIPTION,
  image: new URL('/favicon.svg', site).href,
  logo: new URL('/favicon.svg', site).href,
  founder: { '@type': 'Person', '@id': personId(site), name: OWNER_NAME },
  knowsAbout: SERVICES.flatMap((s) => s.keywords),
  // Same counties and towns the homepage, About page, and footer list.
  areaServed: [
    ...SERVICE_AREA.counties.map((county) => ({
      '@type': 'AdministrativeArea',
      name: `${county} County, Florida`,
    })),
    ...SERVICE_AREA.towns.map((town) => ({
      '@type': 'City',
      name: town,
      containedInPlace: { '@type': 'State', name: 'Florida' },
    })),
  ],
  ...(SOCIAL_LINKS.length > 0 && { sameAs: SOCIAL_LINKS.map((l) => l.href) }),
};

// Every page, including any new page built on this layout, gets the same connected graph:
// Organization + WebSite + this page's WebPage (+ BreadcrumbList and FAQPage when given).
const pageURL = new URL(pagePath(Astro.url), site).href;
const hasBreadcrumb = !!crumbs && crumbs.length > 1;
const structuredData = [
  organization,
  webSiteSchema({ name: SITE_TITLE, description: SITE_DESCRIPTION }, site),
  webPageSchema(
    {
      type: pageType,
      url: pageURL,
      name: titleCase(props.title),
      description: props.description,
      image: new URL((props.image ?? DEFAULT_OG_IMAGE).src, site).href,
      hasBreadcrumb,
      faq: faq?.map((item) => ({ ...item, question: titleCase(item.question) })),
      mainEntityId,
    },
    site,
  ),
  ...(hasBreadcrumb ? [breadcrumbSchema(crumbs, site)] : []),
];
// One JSON-LD block with a single @context and an @graph (tools that read JSON-LD expect an
// object with @context at the top, not a bare array).
const graph = {
  '@context': 'https://schema.org',
  '@graph': structuredData.map(({ '@context': _context, ...node }) => node),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE_TITLE} Blog`} href={new URL('/rss.xml', Astro.site)} />

    {/* Follows the device's light/dark setting (no site toggle). Runs before first paint (no flash),
        again after every View Transition swap, and live when the device switches modes.
        data-theme also tells CSS that JS is running (the header menu relies on it). */}
    <script is:inline>
      (() => {
        const query = window.matchMedia('(prefers-color-scheme: dark)');
        const applyTheme = () => {
          document.documentElement.dataset.theme = query.matches ? 'dark' : 'light';
        };
        applyTheme();
        if (!window.__themeListener) {
          window.__themeListener = true;
          document.addEventListener('astro:after-swap', applyTheme);
          query.addEventListener('change', applyTheme);
          // Clear the choice saved by the old dark-mode toggle; it is no longer used.
          try {
            localStorage.removeItem('theme');
          } catch {}
        }
      })();
    </script>

    <SEO {...props} />
    <JsonLd data={graph} />
    <slot name="head" />

    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    {minimal ? <slot name="top" /> : <Header />}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {minimal ? <slot name="bottom" /> : <Footer />}
  </body>
</html>

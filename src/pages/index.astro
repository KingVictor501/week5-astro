---
import CtaBand from '../components/CtaBand.astro';
import JsonLd from '../components/JsonLd.astro';
import Hero from '../components/home/Hero.astro';
import LatestPosts, { type PostSummary } from '../components/home/LatestPosts.astro';
import ServiceCards from '../components/home/ServiceCards.astro';
import RoiCalculator from '../components/islands/preact/RoiCalculator';
import { BOOK_A_CALL_PATH, SERVICES, SITE_TITLE } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';

// TODO(blog section): replace with the 3 newest entries from the blog content collection.
const latestPosts: PostSummary[] = [];

const siteURL = new URL('/', Astro.site).href;
const webSite = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteURL}#website`,
  name: SITE_TITLE,
  url: siteURL,
  publisher: { '@id': `${siteURL}#organization` },
};
---

<BaseLayout
  title="Lead Generation for Small Businesses"
  description="Lead generation for small businesses through SEO, Google Ads, social media, analytics dashboards, AI, and website development. Book a free call."
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://loremflickr.com" />
    <JsonLd data={webSite} />
  </Fragment>

  <Hero />
  <ServiceCards services={SERVICES} />

  <!-- ROI calculator: Preact island, hydrated only when scrolled into view. -->
  <section id="roi-calculator" class="section roi" aria-labelledby="roi-title">
    <div class="container">
      <RoiCalculator client:visible ctaHref={`${BOOK_A_CALL_PATH}?service=paid-search`} />
    </div>
  </section>

  <LatestPosts posts={latestPosts} />
  <CtaBand />
</BaseLayout>

<style>
  .roi {
    background: var(--color-surface);
  }
</style>

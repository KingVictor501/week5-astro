---
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import Hero from '../components/Hero.astro';
import MarketingCheckup from '../components/islands/preact/MarketingCheckup';
import LatestPosts from '../components/home/LatestPosts.astro';
import ServiceCards from '../components/home/ServiceCards.astro';
import WhoIHelp from '../components/home/WhoIHelp.astro';
import ServiceArea from '../components/ServiceArea.astro';
import RoiCalculator from '../components/islands/preact/RoiCalculator';
import { BOOK_A_CALL_PATH, CALL_LENGTH, listJoin, magnetPath, SERVICE_AREA, SERVICES, SITE_TITLE } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLatestPosts } from '../lib/blog';
import type { FaqItem } from '../lib/schema';

const latestPosts = await getLatestPosts(3);

// Answer-first FAQs: each answer opens with a direct, quotable sentence. The same items feed the
// FAQPage JSON-LD in BaseLayout, so the markup always matches the visible text.
const faq: FaqItem[] = [
  {
    question: 'What does a digital marketing consultant do for a small business?',
    answer:
      'A digital marketing consultant helps a small business get found online, turn visitors into calls, and spend its marketing budget where it actually brings in customers. For a local business, that usually means a fast website, a strong Google Business Profile, showing up in Google and AI answers, simple ads and social posts, and reporting that shows which of it is working.',
  },
  {
    question: 'What areas do you serve?',
    answer: `I serve businesses along ${SERVICE_AREA.region}, from ${SERVICE_AREA.span}, in ${listJoin(SERVICE_AREA.counties)} counties. That includes ${listJoin(SERVICE_AREA.towns)}. I also work remotely with clients anywhere.`,
  },
  {
    question: 'Do you work with large companies?',
    answer:
      "No. I work with owner-run businesses and small offices, like trades and home services, Main Street shops and restaurants, and marine and outdoor businesses. We're a veteran-owned small team ourselves, so you work directly with me from start to finish.",
  },
  {
    question: 'Do you work with plumbers, HVAC companies, roofers, or law firms?',
    answer:
      "Yes, usually starting with AI search. Those fields are crowded with companies competing for the same Google Ads and rankings, so I focus first on generative and answer engine optimization (GEO and AEO): getting your business named when customers ask ChatGPT, Gemini, or Google's AI Overviews who to call. Many businesses in those fields haven't started on that yet.",
  },
  {
    question: 'What is AI search optimization?',
    answer:
      "AI search optimization is making your business easy for AI assistants and search engines to find, trust, and recommend. It combines generative engine optimization (GEO) so ChatGPT, Gemini, and Perplexity cite you, answer engine optimization (AEO) so your answers get quoted, and SEO so you still rank on Google.",
  },
  {
    question: 'Do you build custom websites or work with WordPress, Shopify, Squarespace, and Wix?',
    answer:
      "Both. I'm a full-stack web developer who builds custom websites and web apps from front end to back end, and I also fix, speed up, redesign, and migrate WordPress, Shopify, Squarespace, and Wix sites. On a free call I'll recommend whichever option fits your goals and budget.",
  },
  {
    question: 'How do I know if AI automation is worth it for my business?',
    answer:
      'AI automation is worth it when the time and money it saves outweigh the cost of the tools and setup. I measure how long your repetitive tasks take today, estimate the savings for each automation, and start with the highest-return projects, then report the actual results after launch.',
  },
  {
    question: `How is ${SITE_TITLE} different from a marketing agency?`,
    answer:
      `${SITE_TITLE} is a veteran-owned small team where the person you talk to is the person who analyzes your business, builds the solution, launches it, and measures the results, so nothing gets lost between account managers and specialists. You work directly with the person doing the work, and you own every account, automation, and line of code.`,
  },
  {
    question: 'What happens on the free call?',
    answer:
      `On the free call, which takes about ${CALL_LENGTH}, we talk through your goals, I share the biggest opportunities I see for AI, automation, your website, or your marketing, and you leave with clear next steps, whether or not we work together.`,
  },
];
---

<BaseLayout
  title="Digital Marketing Consultant on Florida's Gulf Coast"
  description="Veteran-owned digital marketing for local businesses from Crystal River to Sarasota: websites, Google and AI search, ads, social, and automation."
  faq={faq}
>
  <Hero
    eyebrow="Digital Marketing Consultant · Web Developer · AI & Automation"
    heading="Digital marketing that gets Gulf Coast businesses found, called, and booked"
    text="I help local businesses from Crystal River to Sarasota show up on Google and in AI answers, turn visitors into calls with a website that works, and stop wasting money on ads, with plain-English reports that show what's working."
    badge="Veteran-owned · Small team · Crystal River to Sarasota"
    ctas={[
      { href: BOOK_A_CALL_PATH, label: 'Book a Call', primary: true },
      { href: '#services', label: 'See Services' },
    ]}
  >
    {/* Interactive marketing checkup: Preact island, server-rendered, hydrated when visible. */}
    <MarketingCheckup slot="media" client:visible />
  </Hero>
  <WhoIHelp />
  <ServiceCards services={SERVICES} />

  {/* ROI calculator: Preact island, hydrated only when scrolled into view. */}
  <section id="roi-calculator" class="section roi" aria-labelledby="roi-title">
    <div class="container">
      <RoiCalculator
        client:visible
        ctaHref={`${BOOK_A_CALL_PATH}?service=paid-search`}
        resource={{ href: magnetPath('paid-search', 'google-ads-audit-checklist'), label: 'Get the free Google Ads Audit Checklist' }}
      />
    </div>
  </section>

  <LatestPosts posts={latestPosts} />
  <ServiceArea alt />
  <Faq heading="Questions small business owners ask" items={faq} />
  <CtaBand />
</BaseLayout>

<style>
  .roi {
    background: var(--color-surface);
  }
</style>

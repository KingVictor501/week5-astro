---
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import JsonLd from '../components/JsonLd.astro';
import { OWNER_NAME, OWNER_ROLE, SITE_TITLE, SOCIAL_LINKS } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { personId, personSchema, type Crumb, type FaqItem, type PersonCredential } from '../lib/schema';

// Every statement on this page comes from the owner's provided facts:
// Air Force veteran with 12+ years of experience incl. digital marketing leadership;
// MS in Digital Audiences Strategy, Arizona State University (Walter Cronkite School);
// CDMP, Google Analytics and Meta certified; Big Tech Digital Marketing Manager and
// Webmaster experience; builds AI and automation solutions as a freelancer;
// Applied AI Mastery certificate, Millersville University, Lombardo College of Business
// (19-week, 475-hour program: automation and AI agents, AI-assisted software development,
// security, deployment, business systems analysis and ROI, real-business capstone).
// Written as completed, per the course instructor: the site launches on graduation day.
// Do not add employers, dates, places, clients, or achievements beyond these.

const site = Astro.site!;
const description =
  "Air Force veteran, AI and automation consultant, and full-stack web developer with 12+ years of experience, Big Tech webmaster experience, and an ASU master's.";

const credentials: PersonCredential[] = [
  {
    name: 'Applied AI Mastery Certificate',
    category: 'certificate',
    recognizedBy: { type: 'CollegeOrUniversity', name: 'Millersville University' },
  },
  {
    name: 'Master of Science in Digital Audiences Strategy',
    category: 'degree',
    recognizedBy: { type: 'CollegeOrUniversity', name: 'Arizona State University' },
  },
  { name: 'Certified Digital Marketing Professional (CDMP)', category: 'certification' },
  { name: 'Google Analytics certification', category: 'certification', recognizedBy: { type: 'Organization', name: 'Google' } },
  { name: 'Meta certification', category: 'certification', recognizedBy: { type: 'Organization', name: 'Meta' } },
];

const crumbs: Crumb[] = [
  { name: 'Home', path: '/' },
  { name: 'About', path: '/about' },
];

const person = personSchema(
  {
    name: OWNER_NAME,
    jobTitle: OWNER_ROLE,
    description,
    alumniOf: [
      { name: 'Millersville University', department: 'Lombardo College of Business' },
      { name: 'Arizona State University', department: 'Walter Cronkite School' },
    ],
    credentials,
    knowsAbout: [
      'AI automation',
      'AI agents and agentic workflows',
      'Business systems analysis',
      'Full-stack web development',
      'Generative engine optimization (GEO)',
      'Answer engine optimization (AEO)',
      'Search engine optimization (SEO)',
      'Google Analytics',
      'Meta advertising',
      'Digital marketing',
    ],
    sameAs: SOCIAL_LINKS.map((l) => l.href),
  },
  site,
);

const principles = [
  {
    title: 'Your goals come first',
    text: 'Every engagement starts with what a good lead, sale, or saved hour looks like for your business. Tools and tactics come after the goal is clear.',
  },
  {
    title: 'Prove the ROI',
    text: "I measure the baseline before building anything, then report the time saved, costs, and revenue impact afterward, so you know what each project is worth.",
  },
  {
    title: 'Plain-English updates',
    text: "You'll always know what I'm working on, why it matters, and what changed, without jargon.",
  },
  {
    title: 'Practical AI, with a human in the loop',
    text: 'I use AI and automation where they save real time, build them securely, and make sure anything customer-facing gets a human review.',
  },
  {
    title: 'You own everything',
    text: 'Your accounts, data, code, automations, dashboards, and website stay yours, with access you control.',
  },
];

const reasons = [
  {
    fact: 'Trained in applied AI',
    benefit:
      "Millersville University's Applied AI Mastery program trained me to analyze business workflows, build automations and AI agents, and develop, secure, and deploy software, and to prove the ROI with real-business case studies.",
    link: { href: '/ai-and-automation-consulting', text: 'See AI and automation consulting' },
  },
  {
    fact: 'Full-stack developer and former Big Tech webmaster',
    benefit:
      'I’ve worked as a Digital Marketing Manager and Webmaster in Big Tech, and I build custom websites and web apps from front end to back end. I also help with WordPress, Shopify, Squarespace, and Wix.',
    link: { href: '/website-development-and-management', text: 'See full-stack web development' },
  },
  {
    fact: 'Graduate training in audience strategy',
    benefit:
      'My master’s in Digital Audiences Strategy means your content starts with who your customers are and the questions they ask, which is exactly what Google and AI answer engines reward.',
    link: { href: '/ai-search-optimization', text: 'See AI search optimization (GEO, AEO, and SEO)' },
  },
  {
    fact: 'Google Analytics, Meta, and CDMP certified',
    benefit:
      'Your tracking, reporting, and ads are handled by someone formally trained on the platforms you rely on.',
    link: { href: '/marketing-analytics-and-dashboards', text: 'See marketing analytics dashboard services' },
  },
  {
    fact: 'Air Force veteran',
    benefit:
      'I bring the accountability of military service to your project: clear plans, honest updates, and follow-through on what I commit to.',
  },
];

const faq: FaqItem[] = [
  {
    question: `Who runs ${SITE_TITLE}?`,
    answer: `${SITE_TITLE} is run by ${OWNER_NAME}, an Air Force veteran, AI and automation consultant, and full-stack web developer with more than 12 years of experience, including digital marketing leadership and work as a Big Tech Digital Marketing Manager and Webmaster.`,
  },
  {
    question: `What does ${SITE_TITLE} do?`,
    answer: `${SITE_TITLE} helps small businesses grow with AI and automation consulting, custom full-stack web development, and AI search optimization (GEO, AEO, and SEO), plus Google Ads management, social media marketing, and marketing analytics dashboards.`,
  },
  {
    question: `What AI training does ${OWNER_NAME} have?`,
    answer: `${OWNER_NAME} holds the Applied AI Mastery certificate from Millersville University's Lombardo College of Business, a 19-week, 475-hour program. It covers automations and AI agents, AI-assisted software development, security, deployment, business systems analysis, and ROI, and it ends with a capstone project for a real business.`,
  },
  {
    question: `Is ${OWNER_NAME} a web developer or a marketer?`,
    answer: `Both. ${OWNER_NAME} is a full-stack web developer who builds and deploys custom websites and web apps, and a certified digital marketer (CDMP, Google Analytics, and Meta) with a master's in Digital Audiences Strategy from Arizona State University. That combination means your site is built to bring in leads, not just to look good.`,
  },
  {
    question: `Does ${OWNER_NAME} work with WordPress, Shopify, Squarespace, and Wix sites?`,
    answer: `Yes. Along with custom builds, ${OWNER_NAME} fixes, speeds up, redesigns, and migrates WordPress, Shopify, Squarespace, and Wix websites, and connects them to automation, analytics, and AI tools.`,
  },
];
---

<BaseLayout
  title={`About ${OWNER_NAME}, AI & Automation Consultant`}
  description={description}
  pageType="AboutPage"
  crumbs={crumbs}
  faq={faq}
  mainEntityId={personId(site)}
>
  <JsonLd slot="head" data={person} />

  <section class="about-hero" aria-labelledby="about-title">
    <div class="container">
      <Breadcrumbs crumbs={crumbs} />
      <div class="about-hero-body">
        <div>
          <h1 id="about-title">About {OWNER_NAME}</h1>
          <p class="about-lead">
            I'm {OWNER_NAME}, an AI and automation consultant and full-stack web developer, and an Air Force veteran
            with more than 12 years of experience, including digital marketing leadership.
          </p>
          <p>
            I hold the Applied AI Mastery certificate from Millersville University's Lombardo College of Business. That
            program trained me to analyze how a business runs, build automations and AI agents that take over
            repetitive work, develop and securely deploy software with AI, and prove the return with real numbers.
          </p>
          <p>
            Before that, I worked as a Digital Marketing Manager and Webmaster in Big Tech. I hold a Master of Science in
            Digital Audiences Strategy from Arizona State University's Walter Cronkite School, and I'm a Certified
            Digital Marketing Professional (CDMP), certified in Google Analytics and Meta.
          </p>
          <p>
            {SITE_TITLE} is how I bring that experience to small businesses: AI and automation that saves time, custom
            websites and web apps, and the visibility to get found on Google and recommended in AI answers.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="how-title">
    <div class="container">
      <h2 id="how-title">How I work</h2>
      <ul class="about-grid" role="list">
        {
          principles.map((p) => (
            <li class="about-card">
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section about-alt" aria-labelledby="credentials-title">
    <div class="container about-narrow">
      <h2 id="credentials-title">Credentials and certifications</h2>
      <ul class="credentials" role="list">
        <li>
          <strong>Applied AI Mastery Certificate</strong>
          <span>Millersville University, Lombardo College of Business</span>
        </li>
        <li>
          <strong>Master of Science, Digital Audiences Strategy</strong>
          <span>Arizona State University, Walter Cronkite School</span>
        </li>
        <li>
          <strong>Certified Digital Marketing Professional (CDMP)</strong>
        </li>
        <li>
          <strong>Google Analytics certified</strong>
        </li>
        <li>
          <strong>Meta certified</strong>
        </li>
        <li>
          <strong>Digital Marketing Manager and Webmaster experience</strong>
          <span>Big Tech</span>
        </li>
        <li>
          <strong>Air Force veteran</strong>
        </li>
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="why-title">
    <div class="container">
      <h2 id="why-title">Why work with me</h2>
      <ul class="about-grid" role="list">
        {
          reasons.map((r) => (
            <li class="about-card about-reason">
              <h3>{r.fact}</h3>
              <p>{r.benefit}</p>
              {r.link && <a href={r.link.href}>{r.link.text}</a>}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Faq heading={`Questions about ${OWNER_NAME} and ${SITE_TITLE}`} items={faq} alt />

  <CtaBand
    heading="Let's talk about your business"
    text="Book a free call and tell me where you want your business to grow, or which work you'd like off your plate. I'll share honest next steps, whether or not we end up working together."
  />
</BaseLayout>

<style>
  .about-hero {
    padding-block: var(--space-5) var(--space-7);
    background: linear-gradient(180deg, var(--color-surface) 0%, var(--color-bg) 100%);
  }

  .about-hero-body {
    margin-top: var(--space-5);
  }

  .about-lead {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    color: var(--color-heading);
  }

  .about-hero p:not(.about-lead) {
    max-width: 62ch;
    color: var(--color-text-muted);
  }

  .about-alt {
    background: var(--color-surface);
  }

  .about-grid {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 40rem) {
    .about-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .about-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .about-card {
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface-raised);
  }

  .about-card h3 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-2);
  }

  .about-card p {
    margin: 0;
  }

  .about-reason {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .about-reason p {
    flex: 1;
  }

  .about-reason a {
    font-weight: var(--weight-semibold);
  }

  .about-narrow {
    max-width: 48rem;
  }

  .credentials {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .credentials li {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4) var(--space-5);
    border-left: 4px solid var(--color-primary);
    border-radius: var(--radius-sm);
    background: var(--color-surface-raised);
  }

  .credentials span {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
</style>

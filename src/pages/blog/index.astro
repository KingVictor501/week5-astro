---
import BlogIndex from '../../components/blog/BlogIndex.astro';
import { getPublishedPosts, paginate, pickFeatured, toSummary } from '../../lib/blog';

const posts = await getPublishedPosts();
const featured = pickFeatured(posts);
// The featured post leads page 1, so it isn't repeated in the paginated list.
const pages = paginate(posts.filter((p) => p !== featured));
---

<BlogIndex
  allPosts={posts.map(toSummary)}
  pagePosts={pages[0].map(toSummary)}
  featured={featured ? toSummary(featured) : null}
  current={1}
  last={pages.length}
/>

---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { BLOG_CATEGORIES, SERVICES, type BlogCategory } from '../../../consts';

export const getStaticPaths = (() =>
  BLOG_CATEGORIES.map((category) => ({ params: { category: category.slug }, props: { category } }))) satisfies GetStaticPaths;

interface Props {
  category: BlogCategory;
}

const { category } = Astro.props;
const service = SERVICES.find((s) => s.slug === category.service);
---

<BaseLayout
  title={`${category.name} Articles`}
  description={`Articles about ${category.name.toLowerCase()} for small business owners and marketers.`}
>
  <section class="container section">
    <h1>{category.name} Articles</h1>
    <p class="placeholder-note">Placeholder: posts in this category are listed in a later section.</p>
    {service && <p>Related service: <a href={`/${service.slug}`}>{service.name} services</a></p>}
    <p><a href="/blog">Back to all articles</a></p>
  </section>
</BaseLayout>

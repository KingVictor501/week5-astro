---
import type { GetStaticPaths } from 'astro';
import BlogIndex from '../../../components/blog/BlogIndex.astro';
import { getPublishedPosts, paginate, pickFeatured, toSummary } from '../../../lib/blog';

// Pages 2..N. Page 1 lives at /blog (src/pages/blog/index.astro).
export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();
  const featured = pickFeatured(posts);
  const pages = paginate(posts.filter((p) => p !== featured));
  const allPosts = posts.map(toSummary);
  return pages.slice(1).map((pagePosts, i) => ({
    params: { page: String(i + 2) },
    props: { allPosts, pagePosts: pagePosts.map(toSummary), current: i + 2, last: pages.length },
  }));
}) satisfies GetStaticPaths;

const { allPosts, pagePosts, current, last } = Astro.props;
---

<BlogIndex allPosts={allPosts} pagePosts={pagePosts} featured={null} current={current} last={last} />

---
export interface Props {
  slug: string;
}

// Simple 24x24 stroke icons, one per service. Decorative: the card text names the service.
const paths: Record<string, string> = {
  'search-engine-optimization': 'M10.5 4a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13ZM15.5 15.5 20 20',
  'paid-search': 'M4 19h16M7 15l3-4 3 2 4-6M17 7h-3M17 7v3',
  'social-media-marketing':
    'M5 5h10a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2H9l-4 3v-3a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2ZM19 9h0a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2v3l-4-3h-4',
  'marketing-analytics-and-dashboards': 'M4 20V10M10 20V4M16 20v-7M22 20H2',
  'crm-marketing-automation': 'M4 6h16v12H4zM4 7l8 6 8-6',
  'ai-entrepreneurship':
    'M12 3l1.8 4.7L18.5 9.5l-4.7 1.8L12 16l-1.8-4.7L5.5 9.5l4.7-1.8L12 3ZM18.5 15l.9 2.1 2.1.9-2.1.9-.9 2.1-.9-2.1-2.1-.9 2.1-.9.9-2.1Z',
  'website-development-and-management': 'M3 5h18v14H3zM3 9h18M6 7h.01M9 7h.01M10 13l-2 2 2 2M14 13l2 2-2 2',
};

const d = paths[Astro.props.slug] ?? paths['search-engine-optimization'];
---

<svg
  width="28"
  height="28"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d={d}></path>
</svg>

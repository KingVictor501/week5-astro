---
import { BOOK_A_CALL_PATH } from '../../consts';

// Animated example in place of a stock photo: an AI helper texting back a missed call and
// booking the job. Pure CSS (no island); the text is real, so screen readers get the whole
// conversation. Plays on a loop with a pause button (WCAG 2.2.2) and stays still for
// visitors who prefer reduced motion.
const messages = [
  { from: 'system', text: 'Missed call · 7:12 PM' },
  { from: 'helper', text: "Hi! Sorry we missed your call. This is Sample Lock & Key's after-hours assistant. What can we help with?" },
  { from: 'customer', text: "I'm locked out of my house in Holiday." },
  { from: 'helper', text: 'A technician can be there in about 30 minutes. Want me to send one?' },
  { from: 'customer', text: 'Yes please!' },
];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">AI &amp; Automation Consultant · Full-Stack Web Developer</p>
      <h1 id="hero-title">AI and automation consulting for the businesses that keep the Gulf Coast running</h1>
      <p class="subhead">
        I set up simple AI helpers for your business that answer missed calls, book jobs, and send invoices, and I
        build websites that bring in customers, so you can get back to the work only you can do.
      </p>
      <p class="badge">Veteran-owned · Small team · Crystal River to Sarasota</p>
      <div class="hero-ctas">
        <a class="btn btn-primary btn-lg" href={BOOK_A_CALL_PATH}>Book a Call</a>
        <a class="btn btn-secondary btn-lg" href="#services">See Services</a>
      </div>
    </div>
    <figure class="hero-media">
      <div class="phone" data-hero-demo>
        <div class="phone-top">
          <span class="phone-dot" aria-hidden="true"></span>
          <span>Texts · Sample business</span>
        </div>
        <ol class="chat" role="list">
          {
            messages.map((m) => (
              <li class:list={['msg', `msg-${m.from}`]}>
                {m.from === 'helper' && <span class="visually-hidden">AI helper: </span>}
                {m.from === 'customer' && <span class="visually-hidden">Customer: </span>}
                {m.text}
              </li>
            ))
          }
          <li class="msg msg-booked">
            <span aria-hidden="true">✓</span> Technician on the way, arriving by 7:45 PM. Owner notified.
          </li>
        </ol>
        <button type="button" class="demo-pause" aria-pressed="false" data-hero-pause>Pause animation</button>
      </div>
      <figcaption>Example: an AI helper answering a missed call after hours.</figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-6) var(--space-7);
    background: var(--gradient-hero);
  }

  .hero-grid {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }

  @media (min-width: 56rem) {
    .hero {
      padding-block: var(--space-8);
    }

    .hero-grid {
      grid-template-columns: 1.1fr 1fr;
      gap: var(--space-7);
    }
  }

  .eyebrow {
    margin-bottom: var(--space-3);
    color: var(--color-secondary);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 22ch;
  }

  .subhead {
    max-width: 48ch;
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }

  .badge {
    display: inline-block;
    margin-bottom: var(--space-5);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    background: var(--color-accent-soft);
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }


  .hero-media {
    margin: 0;
  }

  .hero-media figcaption {
    margin-top: var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    text-align: center;
  }

  /* Phone-style card with a fixed height so the animation never shifts the layout. */
  .phone {
    position: relative;
    max-width: 24rem;
    margin-inline: auto;
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: 1.75rem;
    background: var(--color-surface-raised);
    box-shadow: var(--shadow-lg);
  }

  .phone-top {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    padding-bottom: var(--space-3);
    margin-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }

  .phone-dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: var(--radius-pill);
    background: var(--color-primary);
  }

  .chat {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-height: 23rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .msg {
    max-width: 85%;
    padding: var(--space-2) var(--space-3);
    border-radius: 1.1rem;
    font-size: var(--text-sm);
    line-height: 1.45;
  }

  .msg-system {
    align-self: center;
    max-width: none;
    padding: var(--space-1) var(--space-3);
    background: var(--color-secondary-soft);
    color: var(--color-secondary);
    font-weight: var(--weight-bold);
  }

  .msg-helper {
    align-self: flex-start;
    border-bottom-left-radius: 0.3rem;
    background: var(--color-surface);
    color: var(--color-text);
  }

  .msg-customer {
    align-self: flex-end;
    border-bottom-right-radius: 0.3rem;
    background: var(--color-primary);
    color: var(--color-on-primary);
  }

  .msg-booked {
    align-self: stretch;
    max-width: none;
    margin-top: var(--space-2);
    background: var(--color-accent-soft);
    color: var(--color-accent);
    font-weight: var(--weight-bold);
    text-align: center;
  }

  .demo-pause {
    position: absolute;
    top: var(--space-3);
    right: var(--space-4);
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    background: var(--color-surface-raised);
    color: var(--color-text);
    font: inherit;
    font-size: var(--text-xs);
    cursor: pointer;
  }

  /* Messages appear one after another, hold, then all fade and the loop restarts together
     (15s cycle; one keyframe set per message so they share the same reset). */
  @media (prefers-reduced-motion: no-preference) {
    .msg {
      animation-duration: 15s;
      animation-iteration-count: infinite;
      animation-fill-mode: both;
      animation-timing-function: ease-out;
    }

    .msg:nth-child(1) { animation-name: msg-0; }
    .msg:nth-child(2) { animation-name: msg-1; }
    .msg:nth-child(3) { animation-name: msg-2; }
    .msg:nth-child(4) { animation-name: msg-3; }
    .msg:nth-child(5) { animation-name: msg-4; }
    .msg:nth-child(6) { animation-name: msg-5; }

    .phone.paused .msg {
      animation-play-state: paused;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .demo-pause {
      display: none;
    }
  }

  @keyframes msg-0 {
    0%, 0% { opacity: 0; transform: translateY(0.5rem); }
    3%, 88% { opacity: 1; transform: none; }
    95%, 100% { opacity: 0; transform: none; }
  }

  @keyframes msg-1 {
    0%, 11% { opacity: 0; transform: translateY(0.5rem); }
    14%, 88% { opacity: 1; transform: none; }
    95%, 100% { opacity: 0; transform: none; }
  }

  @keyframes msg-2 {
    0%, 22% { opacity: 0; transform: translateY(0.5rem); }
    25%, 88% { opacity: 1; transform: none; }
    95%, 100% { opacity: 0; transform: none; }
  }

  @keyframes msg-3 {
    0%, 33% { opacity: 0; transform: translateY(0.5rem); }
    36%, 88% { opacity: 1; transform: none; }
    95%, 100% { opacity: 0; transform: none; }
  }

  @keyframes msg-4 {
    0%, 44% { opacity: 0; transform: translateY(0.5rem); }
    47%, 88% { opacity: 1; transform: none; }
    95%, 100% { opacity: 0; transform: none; }
  }

  @keyframes msg-5 {
    0%, 55% { opacity: 0; transform: translateY(0.5rem); }
    58%, 88% { opacity: 1; transform: none; }
    95%, 100% { opacity: 0; transform: none; }
  }
</style>

<script>
  // Pause/resume the hero conversation. Bound on every page load (View Transitions swap the DOM).
  document.addEventListener('astro:page-load', () => {
    const button = document.querySelector<HTMLButtonElement>('[data-hero-pause]');
    const phone = document.querySelector<HTMLElement>('[data-hero-demo]');
    if (!button || !phone) return;
    button.addEventListener('click', () => {
      const paused = phone.classList.toggle('paused');
      button.setAttribute('aria-pressed', String(paused));
      button.textContent = paused ? 'Play animation' : 'Pause animation';
    });
  });
</script>

---
import { Image } from 'astro:assets';
import { BOOK_A_CALL_PATH } from '../../consts';

// Hero/LCP image: NOT lazy, and fetched at high priority.
const heroImage = {
  src: 'https://picsum.photos/id/10/1200/900',
  alt: 'A small business owner reviewing an automated workflow on a laptop at a bright, organized desk',
  width: 1200,
  height: 900,
};
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">AI &amp; Automation Consultant · Full-Stack Web Developer</p>
      <h1 id="hero-title">AI and automation consulting for small businesses</h1>
      <p class="subhead">
        I build the automations, AI agents, and websites that take busywork off your plate, bring in leads, and get
        your business recommended on Google and in AI answers, with the ROI measured.
      </p>
      <div class="hero-ctas">
        <a class="btn btn-primary btn-lg" href={BOOK_A_CALL_PATH}>Book a Call</a>
        <a class="btn btn-secondary btn-lg" href="#services">See Services</a>
      </div>
    </div>
    <div class="hero-media">
      <Image
        src={heroImage.src}
        alt={heroImage.alt}
        quality={60}
        width={heroImage.width}
        height={heroImage.height}
        widths={[400, 600, 800, 1000, 1200]}
        sizes="(min-width: 56rem) 34rem, calc(100vw - 2rem)"
        priority
      />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-6) var(--space-7);
    background: linear-gradient(180deg, var(--color-surface) 0%, var(--color-bg) 100%);
  }

  .hero-grid {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }

  @media (min-width: 56rem) {
    .hero {
      padding-block: var(--space-8);
    }

    .hero-grid {
      grid-template-columns: 1.1fr 1fr;
      gap: var(--space-7);
    }
  }

  .eyebrow {
    margin-bottom: var(--space-3);
    color: var(--color-primary);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 18ch;
  }

  .subhead {
    max-width: 48ch;
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    margin-bottom: var(--space-5);
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .hero-media img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    background: var(--color-surface);
  }
</style>

---
import { titleCase } from '../lib/titleCase';
import Breadcrumbs from './Breadcrumbs.astro';
import type { Crumb } from '../lib/schema';

// Split hero: copy on the left, a visual or interactive tool on the right (the "media" slot).
// Used by the homepage and by service pages that want the full spotlight treatment.
export interface Props {
  eyebrow: string;
  heading: string;
  text: string;
  badge?: string;
  ctas: { href: string; label: string; primary?: boolean }[];
  crumbs?: Crumb[];
}

const { eyebrow, heading, text, badge, ctas, crumbs } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container">
    {crumbs && <Breadcrumbs crumbs={crumbs} />}
    <div class:list={['hero-grid', { 'has-crumbs': crumbs }]}>
      <div class="hero-copy">
        <p class="eyebrow">{eyebrow}</p>
        <h1 id="hero-title">{titleCase(heading)}</h1>
        <p class="subhead">{text}</p>
        {badge && <p class="badge">{badge}</p>}
        <div class="hero-ctas">
          {
            ctas.map((cta) => (
              <a class:list={['btn', 'btn-lg', cta.primary ? 'btn-primary' : 'btn-secondary']} href={cta.href}>
                {cta.label}
              </a>
            ))
          }
        </div>
      </div>
      <div class="hero-media">
        <slot name="media" />
      </div>
    </div>
  </div>
</section>

<style>

  .hero {
    padding-block: var(--space-6) var(--space-7);
    background: var(--gradient-hero);
  }

  .hero-grid {
    display: grid;
    gap: var(--space-6);
    align-items: start;
  }

  @media (min-width: 56rem) {
    .hero {
      padding-block: var(--space-8);
    }

    .hero-grid {
      grid-template-columns: 1.1fr 1fr;
      gap: var(--space-7);
    }
  }

  .eyebrow {
    margin-bottom: var(--space-3);
    color: var(--color-secondary);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 22ch;
  }

  .subhead {
    max-width: 48ch;
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }

  .badge {
    display: inline-block;
    margin-bottom: var(--space-5);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    background: var(--color-accent-soft);
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }



  .has-crumbs {
    margin-top: var(--space-5);
  }

  .hero-media {
    min-width: 0;
  }
</style>

---
// Static blog card for the /blog index. Rendered at build time; the BlogBrowser island
// only shows or hides these cards (via `hidden`), it never re-renders them.
import { Image } from 'astro:assets';
import type { PostSummary } from '../../lib/blog';

export interface Props {
  post: PostSummary;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const Heading = featured ? 'h2' : 'h3';
const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---

<article class:list={['bb-card', { 'bb-card-featured': featured }]}>
  <Image
    src={post.image.src}
    alt={post.image.alt}
    quality={60}
    width={post.image.width}
    height={post.image.height}
    widths={[360, 540, 720, 960, 1200]}
    sizes={featured ? '(min-width: 48rem) 38rem, calc(100vw - 2rem)' : '(min-width: 64rem) 22rem, (min-width: 40rem) calc(50vw - 2rem), calc(100vw - 2rem)'}
    priority={featured}
  />
  <div class="bb-card-body">
    {featured && <p class="bb-featured-label">Featured</p>}
    <p class="bb-card-kicker">
      {post.category?.name}
      {post.type === 'case-study' && <span class="bb-type">Case study</span>}
      {post.type === 'news' && <span class="bb-type">News</span>}
    </p>
    <Heading class="bb-card-title">
      <a href={post.href}>{post.title}</a>
    </Heading>
    <p class="bb-card-desc">{post.description}</p>
    <p class="bb-card-meta">
      <time datetime={post.date.toISOString()}>{formatDate(post.date)}</time>
      {post.readingTime && ` · ${post.readingTime} min read`}
    </p>
  </div>
</article>

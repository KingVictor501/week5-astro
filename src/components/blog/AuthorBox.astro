---
import { OWNER_NAME } from '../../consts';

// Built only from the About-page facts. A monogram badge stands in until a real headshot
// is added (swap the badge for an <Image> then).
const initial = OWNER_NAME.trim().charAt(0).toUpperCase();
---

<aside class="author" aria-labelledby="author-title">
  <span class="monogram" aria-hidden="true">{initial}</span>
  <div>
    <h2 id="author-title">Written by {OWNER_NAME}</h2>
    <p>
      AI and automation consultant and full-stack web developer, and an Air Force veteran with more than 12 years of
      experience. Holds the Applied AI Mastery certificate from Millersville University and a Master of Science in
      Digital Audiences Strategy from Arizona State University. Former Big Tech Digital Marketing Manager and
      Webmaster; CDMP, Google Analytics, and Meta certified.
    </p>
    <a href="/about">More about {OWNER_NAME}</a>
  </div>
</aside>

<style>
  .author {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  /* Sea-glass badge with the owner's initial and a coral ring. Decorative: the heading names the author. */
  .monogram {
    flex: none;
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    border-radius: var(--radius-pill);
    background: var(--gradient-band);
    box-shadow: 0 0 0 3px var(--color-surface), 0 0 0 5px var(--color-secondary);
    color: #ffffff;
    font-size: 1.75rem;
    font-weight: var(--weight-bold);
  }

  @media (min-width: 40rem) {
    .monogram {
      width: 5rem;
      height: 5rem;
      font-size: 2.25rem;
    }
  }

  h2 {
    margin-bottom: var(--space-2);
    font-size: var(--text-lg);
  }

  p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }

  a {
    font-weight: var(--weight-semibold);
  }
</style>

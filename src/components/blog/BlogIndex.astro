---
// Shared body for /blog (page 1) and /blog/page/[page].
import Breadcrumbs from '../Breadcrumbs.astro';
import JsonLd from '../JsonLd.astro';
import BlogBrowser from '../islands/react/BlogBrowser';
import { BLOG_CATEGORIES } from '../../consts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { BLOG_PAGE_SIZE, blogPageHref, type PostSummary } from '../../lib/blog';
import { breadcrumbSchema, type Crumb } from '../../lib/schema';

export interface Props {
  allPosts: PostSummary[];
  pagePosts: PostSummary[];
  featured: PostSummary | null;
  current: number;
  last: number;
}

const { allPosts, pagePosts, featured, current, last } = Astro.props;

const crumbs: Crumb[] = [
  { name: 'Home', path: '/' },
  { name: 'Blog', path: '/blog' },
  ...(current > 1 ? [{ name: `Page ${current}`, path: blogPageHref(current) }] : []),
];

const pagination = {
  current,
  last,
  pages: Array.from({ length: last }, (_, i) => ({ number: i + 1, href: blogPageHref(i + 1) })),
  prev: current > 1 ? blogPageHref(current - 1) : undefined,
  next: current < last ? blogPageHref(current + 1) : undefined,
};

const title = current > 1 ? `Digital Marketing Blog, Page ${current}` : 'Digital Marketing Blog for Small Businesses';
const description =
  current > 1
    ? `Page ${current} of practical articles on SEO, Google Ads, social media, analytics, AI, and websites for small businesses.`
    : 'Practical articles on SEO, Google Ads, social media, analytics dashboards, AI automation, and web development for small businesses.';
---

<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    {pagination.prev && <link rel="prev" href={new URL(pagination.prev, Astro.site)} />}
    {pagination.next && <link rel="next" href={new URL(pagination.next, Astro.site)} />}
    <JsonLd data={breadcrumbSchema(crumbs, Astro.site!)} />
  </Fragment>

  <section class="section blog-index" aria-labelledby="blog-title">
    <div class="container">
      <Breadcrumbs crumbs={crumbs} />
      <h1 id="blog-title">{current > 1 ? `Digital marketing blog: page ${current}` : 'Digital marketing blog for small businesses'}</h1>
      <p class="blog-lead">
        Practical, no-hype guides to getting more leads from search, ads, social media, data, AI, and your website.
      </p>

      <BlogBrowser
        client:idle
        posts={allPosts}
        pagePosts={pagePosts}
        featured={featured}
        categories={BLOG_CATEGORIES.map(({ slug, name }) => ({ slug, name }))}
        pagination={pagination}
        pageSize={BLOG_PAGE_SIZE}
      />

      <nav class="blog-topics" aria-labelledby="topics-title">
        <h2 id="topics-title">Browse by topic</h2>
        <ul role="list">
          {
            BLOG_CATEGORIES.map((c) => (
              <li>
                <a href={`/blog/category/${c.slug}`}>{c.name}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  .blog-index h1 {
    margin-top: var(--space-5);
  }

  .blog-lead {
    max-width: 60ch;
    margin-bottom: var(--space-6);
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  .blog-topics {
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  .blog-topics h2 {
    font-size: var(--text-xl);
  }

  .blog-topics ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .blog-topics a {
    display: inline-block;
    padding-block: var(--space-2);
    font-weight: var(--weight-semibold);
  }
</style>

---
// In-article image for MDX posts: explicit size (no layout shift), lazy-loaded, optional caption.
// `align` floats the image so text wraps around it ("right" by default); "full" spans the column.
// On narrow screens every image is full width, since wrapped text would be too cramped to read.
import { Image } from 'astro:assets';

export interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  caption?: string;
  align?: 'right' | 'left' | 'full';
}

const { src, alt, width, height, caption, align = 'right' } = Astro.props;
if (!/^https:\/\/picsum\.photos\/id\/\d+\/\d+\/\d+$/.test(src)) {
  throw new Error(`BlogImage: use https://picsum.photos/id/{unique id}/{w}/{h} (got ${src})`);
}
---

<figure class={`blog-figure blog-figure-${align}`}>
  <Image
    src={src}
    alt={alt}
    quality={60}
    width={width}
    height={height}
    widths={align === 'full' ? [480, 720, 960, 1200] : [320, 480, 640, 860]}
    sizes={align === 'full' ? '(min-width: 64rem) 46rem, calc(100vw - 2rem)' : '(min-width: 40rem) 18rem, calc(100vw - 2rem)'}
  />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .blog-figure {
    margin: var(--space-5) 0;
  }

  @media (min-width: 40rem) {
    .blog-figure-right,
    .blog-figure-left {
      width: min(42%, 18rem);
      margin-block: 0.4rem var(--space-4);
    }

    .blog-figure-right {
      float: right;
      margin-left: var(--space-5);
    }

    .blog-figure-left {
      float: left;
      margin-right: var(--space-5);
    }
  }

  img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  figcaption {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    line-height: 1.4;
  }
</style>
